# .env.example — variáveis de ambiente do CineVault
# Copie este arquivo para .env (na raiz do projeto) e preencha com sua chave real.
# O Expo carrega automaticamente variáveis prefixadas com EXPO_PUBLIC_.

# Chave da API do TMDB (The Movie Database) - gratuita, obtida em:
# https://www.themoviedb.org/settings/api
EXPO_PUBLIC_TMDB_API_KEY=sua_chave_aqui
